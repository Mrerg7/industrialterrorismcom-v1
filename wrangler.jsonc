{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "industrialterrorismcom-v1",
  "compatibility_date": "2026-08-13",
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "industrialterrorism.com", "custom_domain": true },
    { "pattern": "www.industrialterrorism.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
