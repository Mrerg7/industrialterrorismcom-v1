---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found on industrialterrorism.com."
>
  <Header />
  <main class="flex flex-1 flex-col items-center justify-center px-4 py-24 text-center">
    <p class="text-6xl font-bold text-brand-700">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-brand-50">Page not found</h1>
    <p class="mt-2 max-w-md text-brand-400">
      The page you are looking for does not exist or has been moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-light"
    >
      Return home
    </a>
  </main>
  <Footer />
</BaseLayout>
